{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osb://schemas/task-state.schema.json",
  "title": "OSB task state",
  "description": "Compact, mutable, resumable execution state at .osb/state/<task-id>.json. See osb/references/state.md.",
  "type": "object",
  "required": [
    "task_id", "goal", "phase", "acceptance", "units", "review", "qa", "quality"
  ],
  "additionalProperties": true,
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "phase": {
      "type": "string",
      "enum": ["architecture", "implementation", "review", "repair", "qa", "blocked", "complete"]
    },
    "architecture_checkpoint": {"type": ["string", "null"]},
    "task_profile": {
      "type": ["string", "null"],
      "enum": ["small-fix", "feature", "cross-service", "high-risk", null]
    },
    "task_profile_rationale": {"type": ["string", "null"]},
    "risk_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "acceptance": {
      "type": "object",
      "patternProperties": {
        "^AC[A-Za-z0-9_-]+$": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "patternProperties": {
        "^U[A-Za-z0-9_-]+$": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"type": "string", "enum": ["pending", "in-progress", "complete", "blocked"]},
            "files": {"type": "array", "items": {"type": "string"}},
            "checkpoint": {"type": ["string", "null"]},
            "repository_id": {"type": ["string", "null"]}
          }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "clean", "findings", "needs-evidence"]},
        "scope": {"type": "string", "enum": ["delta", "final-combined-change"]},
        "reviewed_revision": {"type": ["string", "null"]},
        "open": {"type": "array", "items": {"type": "string"}},
        "resolved": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qa": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "pass", "fail", "needs-evidence"]},
        "failed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "knowledge_watermark": {"type": ["string", "null"]},
    "workspace": {
      "type": "object",
      "description": "Present only when the task spans more than one repository (Phase 3).",
      "required": ["mode", "repositories"],
      "properties": {
        "mode": {"type": "string", "enum": ["single-repo", "multi-repo"]},
        "workspace_fingerprint": {"type": ["string", "null"]},
        "manifest_fingerprint": {
          "type": ["string", "null"],
          "description": "The confirmed workspace-manifest.schema.json fingerprint this task was scoped against (Next Improvements Phase 1), when discovery was used. A newly affected repository changes this and invalidates stale review/QA approvals the same way an explicit workspace change does. Null when the workspace was configured explicitly without discovery."
        },
        "repositories": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "type": "object",
              "required": ["path", "base_revision"],
              "properties": {
                "path": {"type": "string"},
                "depends_on": {"type": "array", "items": {"type": "string"}},
                "base_revision": {"type": "string"},
                "head_revision": {"type": ["string", "null"]},
                "patch_fingerprint": {"type": ["string", "null"]},
                "changed_files": {"type": "array", "items": {"type": "string"}},
                "status": {"type": "string", "enum": ["pending", "in-progress", "complete", "blocked"]}
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "unresolved_context_requests", "required_ac_ids", "task_base_revision",
        "current_patch_fingerprint", "final_review_fingerprint", "final_qa_fingerprint",
        "unverified_ac_ids"
      ],
      "properties": {
        "unresolved_context_requests": {"type": "array", "items": {"type": "object"}},
        "required_ac_ids": {"type": "array", "items": {"type": "string"}},
        "task_base_revision": {"type": "string", "minLength": 1},
        "current_patch_fingerprint": {"type": "string", "minLength": 1},
        "final_review_fingerprint": {"type": ["string", "null"]},
        "final_qa_fingerprint": {"type": ["string", "null"]},
        "unverified_ac_ids": {"type": "array", "items": {"type": "string"}},
        "knowledge_consolidated": {"type": "boolean"}
      }
    },
    "recovery": {
      "type": "object",
      "description": "Optional bounded-recovery summary (Next Improvements Phase 4). Absent/empty means no repair attempt has been blocked or exhausted. See osb/docs/RECOVERY.md and osb/schemas/recovery-event.schema.json for the underlying append-only event log this summarizes.",
      "properties": {
        "status": {"type": "string", "enum": ["ok", "blocked"]},
        "blocked_role": {"type": ["string", "null"]},
        "last_blocker": {"type": ["string", "null"]},
        "events_file": {"type": ["string", "null"]},
        "attempts": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "properties": {
                "attempt_count": {"type": "integer", "minimum": 0},
                "last_failure_signature": {"type": ["string", "null"]},
                "last_implementation_fingerprint": {"type": ["string", "null"]}
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
